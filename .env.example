# Telegram application credentials from https://my.telegram.org/apps (required).
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Optional login convenience; omit to enter the phone interactively.
TELEGRAM_PHONE=
# Comma-separated numeric chat IDs, commonly -100xxxxxxxxxx.
ALLOWED_CHAT_IDS=-1001234567890
INCLUDE_SAVED_MESSAGES=false

# Portable container paths. More-specific variables override derived paths.
TMD_DATA_DIR=/data
TMD_DATABASE_PATH=/data/db/downloads.db
TMD_SESSION_DIR=/data/session
# Telethon appends .session; this produces /data/session/downloader.session.
TMD_SESSION_NAME=downloader
TMD_CONFIG_DIR=/data/config
TMD_LOG_DIR=/data/logs
TMD_DOWNLOAD_DIR=/downloads
TMD_TEMP_DIR=/downloads/incomplete

# Host bind mounts. Current installations may retain their existing /storage paths.
TMD_DATABASE_HOST_DIR=./data/db
TMD_SESSION_HOST_DIR=./data/session
TMD_CONFIG_HOST_DIR=./data/config
TMD_LOG_HOST_DIR=./data/logs
TMD_DOWNLOAD_HOST_DIR=./downloads

# Strict FIFO mode currently uses one worker.
CONCURRENT_DOWNLOADS=1
MAX_FILE_SIZE_GB=0
MIN_FREE_SPACE_GB=5
BANDWIDTH_LIMIT_MBPS=0
MAX_RETRIES=5
RETRY_BASE_SECONDS=10
STATUS_REPLIES_ENABLED=false
PROGRESS_UPDATE_INTERVAL=15

# Jellyfin refresh is optional and never required for application startup.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_REFRESH_ENABLED=false

# Application listener inside the container.
TMD_WEB_HOST=0.0.0.0
TMD_WEB_PORT=8787
# Host publication address; loopback is the safe default.
TMD_WEB_BIND_ADDRESS=127.0.0.1
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
LOG_LEVEL=INFO

# Container process ownership. Match writable bind-mount ownership.
PUID=1000
PGID=1000
TZ=Etc/UTC

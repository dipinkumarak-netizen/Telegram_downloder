# Telegram credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash
TELEGRAM_SESSION_PATH=/app/session/downloader
# Comma-separated numeric IDs, commonly -100xxxxxxxxxx for channels/supergroups.
ALLOWED_CHAT_IDS=-1001234567890
INCLUDE_SAVED_MESSAGES=false

DATABASE_PATH=/app/database/downloads.db
LOG_DIR=/app/logs
DOWNLOAD_ROOT=/downloads
# Strict FIFO mode always uses one download worker.
CONCURRENT_DOWNLOADS=1
MAX_FILE_SIZE_GB=0
MIN_FREE_SPACE_GB=5
BANDWIDTH_LIMIT_MBPS=0
MAX_RETRIES=5
RETRY_BASE_SECONDS=10

STATUS_REPLIES_ENABLED=false
PROGRESS_UPDATE_INTERVAL=15

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_REFRESH_ENABLED=false

# Keep 0.0.0.0 inside Docker; publish only on a LAN/Tailscale host address in Compose.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
LOG_LEVEL=INFO

PUID=1000
PGID=1000
# Host bind address. Set this to the server's Tailscale IP for tighter access.
DASHBOARD_BIND_IP=127.0.0.1
TZ=Etc/UTC
